---
import activity from '../data/activity.json';
import { roundThousands } from '../lib/stats';

const CELL = 12;
const GAP = 3;
const STEP = CELL + GAP;

const number = new Intl.NumberFormat('en-US');
const levels = (count: number) => {
  if (count === 0) return 0;
  if (count < 5) return 1;
  if (count < 15) return 2;
  if (count < 40) return 3;
  return 4;
};

const cells = activity.weeks.flatMap((week, column) =>
  week.counts.map((count, index) => ({
    x: column * STEP,
    y: (week.firstWeekday + index) * STEP,
    level: levels(count),
  })),
);
const width = activity.weeks.length * STEP - GAP;
const height = 7 * STEP - GAP;
const { totals } = activity;
const measured = [
  ['Commits', totals.commits],
  ['Pull requests merged', totals.pullRequests],
  ['Lines of code', totals.lines],
  ['Lines of tests', totals.testLines],
  ['Repositories', totals.repositories],
] as const;
const total = number.format(activity.total);
const hidden = number.format(activity.private);
---

<section class="activity" aria-labelledby="activity-title">
  <h2 id="activity-title" class="display">
    {roundThousands(totals.lines)} lines,<br /><span>nearly all of it private</span>
  </h2>
  <dl class="measured">
    {
      measured.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd data-count={value}>{number.format(value)}</dd>
        </div>
      ))
    }
  </dl>
  <p class="caption">
    Measured from GitHub every day, most recently on {activity.generated}. Commits include the ones
    inside squash-merged pull requests, which GitHub’s own graph collapses into one. Lines are what’s
    in the repositories today, written with coding agents as well as by hand. Work in my employer’s
    repositories isn’t counted. The grid is my last year of contributions: {total}, of which {hidden}{' '}
    are private.
  </p>
  <div class="scroller" tabindex="0" role="group" aria-label="Contribution heatmap, scrolls sideways">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={`Contribution heatmap: ${total} contributions on ${activity.activeDays} active days in the last year.`}
      data-heatmap
    >
      {cells.map(({ x, y, level }) => <rect x={x} y={y} width={CELL} height={CELL} class={`l${level}`} />)}
    </svg>
  </div>
  <ul class="languages" aria-label="Languages across all repositories">
    {
      activity.languages.slice(0, 5).map(({ name, share }) => (
        <li>
          <span class="name">{name}</span>
          <span class="meter" style={`--share:${share}%`} aria-hidden="true" />
          <span class="share">{share}%</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .activity {
    background: var(--ink);
    padding: clamp(3rem, 8vh, 5rem) var(--gutter);
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: clamp(2.5rem, 7.8vw, 8.5rem);
  }

  h2 span {
    color: var(--flare);
  }

  .measured {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.25rem;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }

  .measured dt {
    font-size: 0.75rem;
    color: var(--dim);
  }

  .measured dd {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2rem, 4.4vw, 4.5rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .caption {
    color: var(--dim);
    max-width: 46rem;
    margin: 1.5rem 0 2.5rem;
    font-size: 0.8125rem;
  }

  .scroller {
    overflow-x: auto;
  }

  svg {
    width: 100%;
    min-width: 46rem;
    height: auto;
  }

  rect {
    fill: var(--ink-raised);
  }

  .l1 {
    fill: #6b3a24;
  }

  .l2 {
    fill: #a84820;
  }

  .l3 {
    fill: #dc5220;
  }

  .l4 {
    fill: var(--flare);
  }

  .languages {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
    font-size: 0.8125rem;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 0.5rem;
  }

  .share {
    color: var(--dim);
  }

  .meter {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 2px;
    background: linear-gradient(var(--bone), var(--bone)) no-repeat left / var(--share) 100%, var(--line);
  }

  @media (max-width: 860px) {
    .measured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .languages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
