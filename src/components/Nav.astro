---
const items = [
  ['#record', 'Record'],
  ['#orders', 'Orders'],
  ['#log', 'Log'],
  ['#contact', 'Contact'],
];
---

<a class="skip no-print" href="#main">Skip to content</a>
<header class="nav no-print" data-nav data-tone="ink">
  <a class="name" href="#top">Jordan Lang</a>
  <nav aria-label="Sections">
    <ul>
      {items.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .skip {
    position: fixed;
    top: 0.5rem;
    left: var(--gutter);
    z-index: 60;
    padding: 0.5rem 0.75rem;
    background: var(--flare);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 500;
    transform: translateY(-300%);
  }

  .skip:focus {
    transform: none;
  }

  /* The bar takes the colour of whatever section is under it, so it never sits on top of text. */
  .nav {
    --nav-bg: var(--ink);
    --nav-fg: var(--bone);
    --nav-line: transparent;
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem var(--gutter);
    font-size: 0.8125rem;
    background: var(--nav-bg);
    color: var(--nav-fg);
    border-bottom: 1px solid var(--nav-line);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }

  .nav[data-scrolled] {
    --nav-line: var(--line);
  }

  .nav[data-tone='paper'] {
    --nav-bg: var(--paper);
    --nav-fg: var(--type);
    --nav-line: var(--paper-line);
  }

  .nav[data-tone='flare'] {
    --nav-bg: var(--flare);
    --nav-fg: var(--ink);
    --nav-line: var(--ink);
  }

  .nav[data-tone='flare'] :focus-visible {
    outline-color: var(--ink);
  }

  .name {
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: clamp(0.75rem, 2.4vw, 2rem);
  }

  li a {
    text-decoration: none;
    background: linear-gradient(currentcolor, currentcolor) no-repeat left bottom / 0 1px;
    transition: background-size 0.3s var(--ease);
    padding-bottom: 2px;
  }

  li a:hover,
  li a[aria-current] {
    background-size: 100% 1px;
  }

  @media (max-width: 350px) {
    .nav {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  import { startNav } from '../scripts/nav';

  startNav();
</script>
