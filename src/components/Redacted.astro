---
import { parseRedactions } from '../lib/redaction';

interface Props {
  source: string;
}

const segments = parseRedactions(Astro.props.source);
---

{
  segments.map((segment) => {
    if (segment.kind === 'text') return segment.text;
    if (segment.kind === 'open') return <span class="bar open" data-bar>{segment.text}</span>;
    return (
      <span
        class="bar sealed"
        role="img"
        tabindex="0"
        aria-label={`Redacted: ${segment.reason}`}
        data-reason={segment.reason}
        style={`--bar:${segment.width}ch`}
      />
    );
  })
}

<style>
  .bar {
    position: relative;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background: linear-gradient(var(--type), var(--type)) no-repeat left center / 100% 100%;
    color: transparent;
    padding: 0.08em 0.15em 0;
    margin-inline: -0.15em;
    transition: background-size 0.5s var(--ease), color 0.15s 0.2s;
  }

  :global(html:not(.motion)) .bar.open,
  .bar.open:hover,
  .bar.open:global(.lifted) {
    background-size: 0 100%;
    color: var(--type);
    background-color: rgb(200 50 31 / 12%);
  }

  .bar.sealed {
    display: inline-block;
    width: var(--bar);
    max-width: 100%;
    height: 1.02em;
    vertical-align: -0.16em;
    margin-inline: 0;
    padding: 0;
    cursor: help;
    background: var(--type);
  }

  .bar.sealed::after {
    content: 'Sealed: ' attr(data-reason);
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.4rem);
    z-index: 3;
    width: max-content;
    max-width: min(16rem, 70vw);
    padding: 0.25rem 0.5rem;
    background: var(--stamp);
    color: #fff;
    font-size: 0.8125rem;
    line-height: 1.3;
    pointer-events: none;
    display: none;
  }

  .bar.sealed:global(.flip)::after {
    left: auto;
    right: 0;
  }

  .bar.sealed:hover::after,
  .bar.sealed:focus::after {
    display: block;
  }

  @media print {
    .bar.open {
      background-size: 0 100%;
      color: var(--type);
    }
  }
</style>
