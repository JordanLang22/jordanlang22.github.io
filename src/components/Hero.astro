---
import { LINKS } from '../data/site';
import { TOPOLOGY } from '../sim/engine';

const lines = ['Software that', 'keeps its word'];

const place: Record<string, [number, number]> = {
  'source-a': [5, 15],
  'source-b': [5, 48],
  'source-c': [5, 81],
  ingest: [30, 48],
  store: [49, 48],
  translate: [68, 48],
  'product-a': [94, 15],
  'product-b': [94, 48],
  'product-c': [94, 81],
};
const products = TOPOLOGY.filter((node) => node.kind === 'product');

const traffic = [
  ['Delivered', 'stat-delivered'],
  ['Returned', 'stat-returned'],
  ['Retried', 'stat-retried'],
  ['Deduplicated', 'stat-deduplicated'],
];
// The promises. Each is counted by an auditor that only watches outcomes, so each can fail.
const vows = [
  ['Lost', 'stat-lost'],
  ['Applied twice', 'stat-twice'],
  ['Out of order', 'stat-order'],
  ['Misrouted', 'stat-misrouted'],
];
const conditions = [
  ['loss', 'Drop packets'],
  ['duplicate', 'Duplicate packets'],
  ['jitter', 'Shuffle order'],
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <h1 id="hero-title" class="display title" aria-label={lines.join(' ')}>
    {
      lines.map((line) => (
        <span class="line" aria-hidden="true">
          {line.split(' ').map((word) => (
            <span class:list={['word', { accent: word === 'word' }]}>
              {[...word].map((char) => (
                <span class="char">{char}</span>
              ))}{' '}
            </span>
          ))}
        </span>
      ))
    }
  </h1>

  <div class="intro-row">
    <p class="lede">
      Jordan Lang. Full stack engineer in Boise, Idaho. I build platforms, distributed systems, and
      the software people depend on when something has already gone wrong.
    </p>
    <p class="prompt no-print">
      <span id="sim-status" role="status">Try to lose a message. Take a node down, switch a product off, or use the attacks below. The four numbers on the right have to stay at zero.</span>
    </p>
  </div>

  <div class="network no-print" id="network">
    <canvas id="network-canvas" aria-hidden="true"></canvas>
    {
      TOPOLOGY.map((node) => (
        <button
          type="button"
          class:list={['node', node.kind]}
          data-node={node.id}
          data-label={node.label}
          aria-pressed="false"
          aria-label={`${node.label} down`}
          style={`left:${place[node.id]?.[0]}%;top:${place[node.id]?.[1]}%`}
        >
          <span class="mark" aria-hidden="true"></span>
          <span class="label" aria-hidden="true">{node.label}</span>
        </button>
      ))
    }
    {
      products.map((node) => (
        <button
          type="button"
          class="route"
          role="switch"
          aria-checked="true"
          aria-label={`Route messages to ${node.label}`}
          data-route={node.id}
          data-label={node.label}
          style={`left:${place[node.id]?.[0]}%;top:${place[node.id]?.[1]}%`}
        >
          <span class="track" aria-hidden="true"><span class="thumb"></span></span>
        </button>
      ))
    }
  </div>

  <div class="readout no-print" aria-hidden="true">
    <p class="translation" id="translation"><span>Waiting for traffic</span></p>
    <p class="legend">
      <span class="to">To products</span>
      <span class="back">Back to sources</span>
      <span class="retry">Retry</span>
    </p>
  </div>

  <div class="attacks no-print">
    <div class="weapons" role="group" aria-labelledby="attacks-label">
      <span class="attacks-label" id="attacks-label">Attack it</span>
      {
        conditions.map(([key, label]) => (
          <button type="button" data-chaos={key} aria-pressed="false">{label}</button>
        ))
      }
      <button type="button" data-attack="crash">Crash the store</button>
      <button type="button" data-attack="blackout">Kill everything</button>
    </div>
    <p class="proof">
      <span id="sim-seed"></span>
      <a href={LINKS.invariants}>Read the tests</a>
      <button type="button" id="sim-toggle">Pause</button>
    </p>
  </div>

  <dl class="counters no-print">
    {traffic.map(([label, id]) => <div><dt>{label}</dt><dd id={id}>0</dd></div>)}
    {
      vows.map(([label, id]) => (
        <div class="vow">
          <dt>{label}<span class="sr-only">, has to stay at zero</span></dt>
          <dd id={id}>0</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(12.5rem, 1fr) auto auto auto;
    padding-top: 3.5rem;
    overflow: hidden;
  }

  :global(html[data-degraded]) .hero::before {
    transform: scaleX(1);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--flare);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }

  .title {
    padding-inline: var(--gutter);
    font-size: min(16.35vw, 24svh);
    line-height: 0.84;
    margin-top: 0.25rem;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  .word {
    display: inline-block;
    white-space: pre;
  }

  .char {
    display: inline-block;
  }

  .accent {
    color: var(--flare);
  }

  :global(html.intro) .char {
    opacity: 0;
  }

  .intro-row {
    display: grid;
    grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
    gap: 2rem;
    padding: 1.25rem var(--gutter) 0;
    align-items: end;
  }

  .lede {
    color: var(--bone);
    font-size: clamp(0.875rem, 1.05vw, 1rem);
  }

  .prompt {
    justify-self: end;
    text-align: right;
    color: var(--dim);
    font-size: 0.8125rem;
    min-height: 1.3em;
  }

  .network {
    position: relative;
    margin: 0.5rem var(--gutter) 0.25rem;
    min-height: clamp(12.5rem, 24svh, 15rem);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .node {
    --size: 1.25rem;
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    cursor: crosshair;
  }

  .node.store {
    --size: 1.875rem;
  }

  .node.product .mark::after {
    inset: 18%;
  }

  [data-node='product-a'] .mark::after {
    border-radius: 50%;
  }

  [data-node='product-b'] .mark::after {
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  [data-node='product-c'] .mark::after {
    clip-path: polygon(50% 4%, 100% 96%, 0 96%);
  }

  .mark {
    position: relative;
    width: var(--size);
    height: var(--size);
    background: var(--ink);
    border: 1.5px solid var(--bone);
    transition: border-color 0.15s, background 0.15s, transform 0.2s var(--ease);
  }

  .mark::after {
    content: '';
    position: absolute;
    inset: 22%;
    background: var(--bone);
    transition: opacity 0.15s;
  }

  .node:hover .mark {
    border-color: var(--flare);
    transform: scale(1.18);
  }

  .node[aria-pressed='true'] .mark {
    border-color: var(--flare);
    background:
      linear-gradient(45deg, transparent 47%, var(--flare) 47% 53%, transparent 53%),
      linear-gradient(-45deg, transparent 47%, var(--flare) 47% 53%, transparent 53%);
  }

  .node[aria-pressed='true'] .mark::after {
    opacity: 0;
  }

  .label {
    position: absolute;
    bottom: calc(50% + var(--size) / 2 + 0.3rem);
    font-size: 0.6875rem;
    white-space: nowrap;
    color: var(--dim);
  }

  .node[aria-pressed='true'] .label {
    color: var(--flare);
  }

  .node.source .label {
    left: calc(50% - var(--size) / 2);
  }

  .node.product .label {
    right: calc(50% - var(--size) / 2);
  }

  .route {
    position: absolute;
    width: 2.75rem;
    height: 1.75rem;
    transform: translate(-50%, 0.75rem);
    display: grid;
    place-items: center;
  }

  .track {
    position: relative;
    width: 1.75rem;
    height: 0.8125rem;
    border: 1px solid var(--bone);
    transition: border-color 0.15s;
  }

  .thumb {
    position: absolute;
    top: 1.5px;
    left: 1.5px;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--bone);
    transform: translateX(0.875rem);
    transition: transform 0.2s var(--ease), background 0.15s;
  }

  .route:hover .track {
    border-color: var(--flare);
  }

  .route[aria-checked='false'] .track {
    border-color: var(--dim);
    border-style: dashed;
  }

  .route[aria-checked='false'] .thumb {
    background: var(--dim);
    transform: none;
  }

  .readout {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding: 0.4rem var(--gutter) 0.6rem;
    font-size: 0.6875rem;
    color: var(--dim);
  }

  .translation {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .translation :global(b) {
    font-weight: 400;
    color: var(--bone);
  }

  .translation :global(i) {
    font-style: normal;
    color: var(--dim);
    margin-inline: 0.5em;
  }

  .legend {
    display: flex;
    flex: none;
    gap: 1.25rem;
  }

  .legend span::before {
    content: '';
    display: inline-block;
    width: 0.875rem;
    height: 2px;
    margin-right: 0.45em;
    vertical-align: 0.2em;
    background: currentcolor;
  }

  .to {
    color: var(--bone);
  }

  .back {
    color: var(--answer);
  }

  .retry {
    color: var(--flare);
  }

  .attacks {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: 0.55rem var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .weapons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .attacks-label {
    color: var(--flare);
    margin-right: 0.5rem;
  }

  .weapons button {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    color: var(--bone);
    line-height: 1.4;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }

  .weapons button:hover {
    border-color: var(--bone);
  }

  .weapons button[aria-pressed='true'],
  .weapons button:active {
    border-color: var(--flare);
    color: var(--flare);
    background: rgb(255 91 31 / 12%);
  }

  .proof {
    display: flex;
    flex: none;
    align-items: center;
    gap: 1.25rem;
    color: var(--dim);
  }

  .proof a,
  .proof button {
    color: var(--bone);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--dim);
  }

  .proof a:hover,
  .proof button:hover {
    color: var(--flare);
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  /* The promises sit apart from the traffic: a rule in the colour of an answer that came home. */
  .vow {
    box-shadow: inset 0 2px var(--answer);
  }

  .vow dd {
    color: var(--answer);
  }

  .vow:has([data-broken]) {
    box-shadow: inset 0 2px var(--flare);
  }

  .vow dd[data-broken] {
    color: var(--flare);
  }

  .counters > div {
    padding: 0.7rem 0 0.8rem var(--gutter);
    border-left: 1px solid var(--line);
  }

  .counters > div:first-child {
    border-left: 0;
  }

  dt {
    font-size: 0.6875rem;
    color: var(--dim);
  }

  dd {
    font-size: clamp(1rem, 1.7vw, 1.5rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  /* On a short, wide screen the headline gives way so the numbers stay above the fold. */
  @media (max-height: 800px) and (min-width: 761px) {
    .title {
      font-size: min(16.35vw, 17svh);
    }
  }

  @media (max-width: 760px) {
    .title {
      font-size: 21.5vw;
    }

    .line {
      display: inline;
      white-space: normal;
    }

    .network {
      min-height: 20rem;
    }

    .legend {
      display: none;
    }

    .intro-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .prompt {
      justify-self: start;
      text-align: left;
      color: var(--flare);
      /* Three lines, the longest message, so a new message never shoves the network down. */
      min-height: 4.8em;
    }

    .counters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero {
      grid-template-rows: auto auto minmax(20rem, 1fr) auto auto auto;
    }

    .counters > div {
      padding-left: var(--gutter);
    }

    .counters > div:nth-child(odd) {
      border-left: 0;
    }

    .counters > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .attacks {
      flex-direction: column;
      align-items: flex-start;
    }

    .attacks-label {
      flex-basis: 100%;
    }

    .weapons button {
      padding: 0.5rem 0.7rem;
    }
  }
</style>

<script>
  import { startHero } from '../scripts/hero';

  startHero();
</script>
